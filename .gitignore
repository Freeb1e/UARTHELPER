# 默认忽略所有内容
*

# 允许继续遍历子目录
!*/

# 只保留 Python 文件和 README
!*.py
!README
!README.*

# Scloud UART runners compile these official-DRNG adapters at runtime.
!SCLOUDKEYGEN/derive_inputs.c
!SCLOUDENCAPS/derive_message.c

# Canonical Scloud+512 board commands are release test artifacts.
!SCLOUDKEYGEN/keygen_commands_512.txt
!SCLOUDENCAPS/encaps_commands_512.txt
!SCLOUDDECAPS/decaps_commands_512.txt

# Line-aligned manual UART acceptance vectors and their generation inputs.
!MANUAL_VECTOR_ACCEPTANCE_CN.md
!input.txt
!SCLOUDKEYGEN/keygen_commands_*.txt
!SCLOUDKEYGEN/*_ref_*.txt
!SCLOUDENCAPS/encaps_commands_*.txt
!SCLOUDENCAPS/*_ref_*.txt
!SCLOUDDECAPS/decaps_commands_*.txt
!SCLOUDDECAPS/*_ref_*.txt
!MLKEMKEYGEN/generate_golden.c
!MLKEMKEYGEN/keygen_commands_*.txt
!MLKEMKEYGEN/*_ref_*.txt
!MLKEMENCAPS/generate_golden.c
!MLKEMENCAPS/encaps_inputs_*.txt
!MLKEMENCAPS/encaps_commands_*.txt
!MLKEMENCAPS/*_ref_*.txt
!MLKEMDECAPS/generate_golden.c
!MLKEMDECAPS/decaps_inputs_*.txt
!MLKEMDECAPS/decaps_commands_*.txt
!MLKEMDECAPS/*_ref_*.txt
!MLDSAKEYGEN/generate_golden.c
!MLDSAKEYGEN/keygen_commands_*.txt
!MLDSAKEYGEN/*_ref_*.txt
!MLDSASIGN/generate_golden.c
!MLDSASIGN/sign_commands_*.txt
!MLDSASIGN/sign_uart_commands_*.txt
!MLDSASIGN/*_ref_*.txt
!MLDSAVERIFY/generate_golden.c
!MLDSAVERIFY/verify_commands_*.txt
!MLDSAVERIFY/verify_uart_commands_*.txt
!MLDSAVERIFY/*_ref_*.txt

# 保留 .gitignore 自身
!.gitignore

# Complete Frodo board input/reference packages.
!FRODO/requirements.txt
!FRODO/CHAGELOG.md
!FRODO/vectors/*.json
!FRODOKEYGEN/*_commands_*.txt
!FRODOKEYGEN/*_ref_*.txt
!FRODOKEYGEN/cases_*.jsonl
!FRODOKEYGEN/CHAGELOG.md
!FRODOKEYGEN/requirements.txt
!FRODOENCAPS/*_commands_*.txt
!FRODOENCAPS/*_ref_*.txt
!FRODOENCAPS/cases_*.jsonl
!FRODOENCAPS/CHAGELOG.md
!FRODOENCAPS/requirements.txt
!FRODODECAPS/*_commands_*.txt
!FRODODECAPS/*_ref_*.txt
!FRODODECAPS/cases_*.jsonl
!FRODODECAPS/requirements.txt
!FRODODECAPS/CHAGELOG.md
