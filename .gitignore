# 默认忽略所有内容
*

# 允许继续遍历子目录
!*/

# 只保留 Python 文件和 README
!*.py
!README
!README.*

# Scloud UART runners compile these official-DRNG adapters at runtime.
!SCLOUDKEYGEN/derive_inputs.c
!SCLOUDENCAPS/derive_message.c

# Canonical Scloud+512 board commands are release test artifacts.
!SCLOUDKEYGEN/keygen_commands_512.txt
!SCLOUDENCAPS/encaps_commands_512.txt
!SCLOUDDECAPS/decaps_commands_512.txt

# 保留 .gitignore 自身
!.gitignore

# Complete Frodo board input/reference packages.
!FRODO/requirements.txt
!FRODO/CHAGELOG.md
!FRODO/vectors/*.json
!FRODOKEYGEN/*_commands_*.txt
!FRODOKEYGEN/*_ref_*.txt
!FRODOKEYGEN/cases_*.jsonl
!FRODOKEYGEN/CHAGELOG.md
!FRODOKEYGEN/requirements.txt
!FRODOENCAPS/*_commands_*.txt
!FRODOENCAPS/*_ref_*.txt
!FRODOENCAPS/cases_*.jsonl
!FRODOENCAPS/CHAGELOG.md
!FRODOENCAPS/requirements.txt
!FRODODECAPS/*_commands_*.txt
!FRODODECAPS/*_ref_*.txt
!FRODODECAPS/cases_*.jsonl
!FRODODECAPS/requirements.txt
!FRODODECAPS/CHAGELOG.md
